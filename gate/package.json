{
  "name": "@dsh.so/dsh-security-gate",
  "version": "0.1.1",
  "type": "module",
  "main": "index.js",
  "description": "DSH host plugin: auto-audits newly installed plugins (presets and profile packages) with the harness's own model, exposes batch audit tools, and renders an audit panel in Settings.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihuajiu/dsh-code-security.git"
  },
  "homepage": "https://github.com/ihuajiu/dsh-code-security",
  "bugs": {
    "url": "https://github.com/ihuajiu/dsh-code-security/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "security",
    "audit",
    "codex-security"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "audit-baseline.json",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
